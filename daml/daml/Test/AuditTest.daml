        details = "statistics on an inclusion check"

testRequesterCannotCompleteAudit : Script ()
testRequesterCannotCompleteAudit = do
  tp <- setupParties
  fundedCid <- createFunded tp 5000 10000
  submitMustFail tp.requester do
    exerciseCmd fundedCid CompleteAudit with
      result = VerificationResult with
        expected = num 1
        actual = num 1
        matches = True
        details = "marking my own homework"

testRefundAudit : Script ()
testRefundAudit = do
  tp <- setupParties
  fundedCid <- createFunded tp 5000 10000

  returnedCid <- submit tp.auditor do
    exerciseCmd fundedCid RefundAudit with
      reason = "the query this audit refers to could not be found"

  Some returned <- queryContractId tp.requester returnedCid
  assertMsg "the tokens come back to the requester" (returned.owner == tp.requester)
  assertMsg "the locked portion comes back in full" (returned.amount == 5000)
  assertMsg "and unlocked" (isNone returned.locker)

  fundedGone <- queryContractId tp.requester fundedCid
  assertMsg "refunding consumes the funded request" (isNone fundedGone)

testRefundAuditRequiresReason : Script ()
testRefundAuditRequiresReason = do
  tp <- setupParties
  fundedCid <- createFunded tp 5000 10000
  submitMustFail tp.auditor do
    exerciseCmd fundedCid RefundAudit with reason = ""

testRequesterCannotRefund : Script ()
testRequesterCannotRefund = do
  tp <- setupParties
  fundedCid <- createFunded tp 5000 10000
  submitMustFail tp.requester do
    exerciseCmd fundedCid RefundAudit with reason = "I changed my mind"

-- The operator is not a stakeholder of any audit contract; seeing a request would tell it what
-- is about to be checked.
testOperatorSeesNoStageOfAnAudit : Script ()
testOperatorSeesNoStageOfAnAudit = do
  tp <- setupParties

  reqCid <- createRequest tp InclusionVerification inclusionParams
  reqSeen <- queryContractId tp.operator reqCid
  assertMsg "the operator cannot see the request" (isNone reqSeen)

  propCid <- submit tp.auditor do
    exerciseCmd reqCid ProposeAuditPrice with
      estimatedCost = 3000
      description = "Verify inclusion for TX-2024-LISBON-001"
  propSeen <- queryContractId tp.operator propCid
  assertMsg "nor the quoted price" (isNone propSeen)

  holdingCid <- createAuditTokens tp 5000
  fundedCid <- submit tp.requester do
    exerciseCmd propCid FundAudit with auditTokenHoldingCid = holdingCid
  fundedSeen <- queryContractId tp.operator fundedCid
  assertMsg "nor that the audit was funded and is about to run" (isNone fundedSeen)

  resultCid <- submit tp.auditor do
    exerciseCmd fundedCid CompleteAudit with
      result = VerificationResult with
        expected = num 3
        actual = num 3
        matches = True
        details = "Inclusion verified"
  resultSeen <- queryContractId tp.operator resultCid
  assertMsg "nor the finding" (isNone resultSeen)

  requesterSees <- queryContractId tp.requester resultCid
  assertMsg "the requester gets their answer" (isSome requesterSees)
  auditorSees <- queryContractId tp.auditor resultCid
  assertMsg "and the auditor keeps its record" (isSome auditorSees)

testStrangerSeesNothing : Script ()
testStrangerSeesNothing = do
  tp <- setupParties
  reqCid <- createRequest tp PricingVerification pricingParams
  seen <- queryContractId tp.stranger reqCid
  assertMsg "an unrelated party cannot see an audit request" (isNone seen)

testAllThreeVerificationTypes : Script ()
testAllThreeVerificationTypes = do
  tp <- setupParties
  let go requestType params = do
        now <- getTime
        reqCid <- submit tp.requester do
          createCmd AuditRequest with
            requestId = "AUDIT-REQ-" <> show requestType
            requester = tp.requester
            auditor = tp.auditor
            requestType
            params
            createdAt = now
        submit tp.auditor do
          exerciseCmd reqCid ProposeAuditPrice with
            estimatedCost = 1000
            description = "priced"

  _ <- go PricingVerification pricingParams
  _ <- go RewardVerification (pricingParams with rewardGroupId = Some "DIST-001")
  _ <- go InclusionVerification inclusionParams
  pure ()
