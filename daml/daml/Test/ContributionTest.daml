thirdVersionData : ContributionData
thirdVersionData = ContributionData with
  propertyAddress = Some Address with
    postalCode = Some "12345"
    street = Some "Main Street 1"
    city = Some "Berlin"
    country = Some "Germany"
    additionalInfo = None
  salePrice = Some 520000.0  -- Different from both sampleContributionData and differentContributionData
  saleDate = Some (date 1970 Jan 1)  -- script time starts at the epoch, and a sale cannot postdate its report
  propertyType = Some "Apartment"
  squareMeters = Some 105.0
  numberOfRooms = Some 4
  yearBuilt = Some 2000
  energyRating = Some B
  tags = Some ["renovated", "balcony"]
  additionalInfo = None

testJoinExistentDisputeWithNewData : Script ()
testJoinExistentDisputeWithNewData = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-JOIN-001"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-JOIN-001"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-JOIN-002"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-JOIN-001"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  requestCid3 <- submit brokerParty do
    createCmd ContributionRequest with
      requestId = "REQ-JOIN-003"
      contributor = brokerParty
      operator
      auditor
      transactionId = TransactionId "TX-JOIN-001"
      contributionData = thirdVersionData
      roleInTransaction = Broker
      requestDate = now
      createdAt = now

  updatedDisputeCid <- submit operator do
    exerciseCmd requestCid3 JoinExistentDispute with
      existingDisputeCid = disputeCid
      contributorData = makeContributorData brokerParty Broker

  updatedDispute <- queryContractId buyer updatedDisputeCid
  let ud = fromSome updatedDispute
  assertMsg "Should have 3 contributors" (Map.size ud.contributorsData == 3)
  assertMsg "Should have 3 data versions" (length ud.allData == 3)
  assertMsg "Broker should be in contributors" (brokerParty `elem` Map.keys ud.contributorsData)

  pure ()

