testProposeDisputeDataNewAlternative : Script ()
testProposeDisputeDataNewAlternative = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-040"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-040"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-041"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-040"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  -- the buyer thinks neither option is right and puts a third one forward
  let realData = sampleContributionData with salePrice = Some 495000.0

  proposeResult <- submit buyer do
    exerciseCmd disputeCid ProposeDisputeData with
      proposer = buyer
      newContributionData = realData

  case proposeResult of
    Left newDisputeCid -> do
      updated <- fromSome <$> queryContractId buyer newDisputeCid
      assertMsg "Should now have 3 data versions" (length updated.allData == 3)
      assertMsg "Proposed data should be appended as option 2"
        (List.elemIndex realData updated.allData == Some 2)
      assertMsg "Proposer should have auto-voted for their own proposal"
        (Map.lookup buyer updated.votes == Some 2)
      assertMsg "Proposer's initial position must move onto their own proposal"
        (Map.lookup buyer updated.initialPositions == Some 2)
      assertMsg "Other contributors' initial positions must be untouched"
        (Map.lookup seller updated.initialPositions == Some 1)
      assertMsg "Contributor set must be unchanged"
        (Map.keys updated.contributorsData == Map.keys updated.initialPositions)
    Right _ -> fail "A brand-new alternative can never be unanimous, so voting must continue"

  pure ()

testProposeDisputeDataDeduplicatesAndResolves : Script ()
testProposeDisputeDataDeduplicatesAndResolves = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-042"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-041"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-043"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-041"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  authorityDisclosure <- fromSome <$> queryDisclosure operator tokenMintAuthorityCid

  -- proposing the seller's data is a vote for option 1, which makes the dispute unanimous
  proposeResult <- submitWithDisclosures buyer [authorityDisclosure] do
    exerciseCmd disputeCid ProposeDisputeData with
      proposer = buyer
      newContributionData = differentContributionData

  case proposeResult of
    Right resolvedCid -> do
      resolved <- fromSome <$> queryContractId buyer resolvedCid
      assertMsg "Resolved contribution should carry the agreed-on data"
        (resolved.contributionData == differentContributionData)
      assertMsg "Should have recorded a dispute date" (not $ null resolved.disputeDates)
    Left disputeCid' -> do
      d <- fromSome <$> queryContractId buyer disputeCid'
      fail ("Expected resolution, still open with " <> show (length d.allData) <> " options")

  pure ()

-- Proposing the option the dispute settles on makes the proposer a winner, even though their
-- original submission was wrong.
testProposeDisputeDataProposerWinsOnTheirOwnProposal : Script ()
testProposeDisputeDataProposerWinsOnTheirOwnProposal = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-046"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-043"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-047"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-043"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  authorityDisclosure <- fromSome <$> queryDisclosure operator tokenMintAuthorityCid

  let realData = sampleContributionData with salePrice = Some 495000.0

  proposeResult <- submit buyer do
    exerciseCmd disputeCid ProposeDisputeData with
      proposer = buyer
      newContributionData = realData

  disputeCid2 <- case proposeResult of
    Left cid -> pure cid
    Right _ -> fail "A brand-new alternative cannot resolve the dispute on its own"

  voteResult <- submitWithDisclosures seller [authorityDisclosure] do
    exerciseCmd disputeCid2 Vote with
      voteForDataIndex = 2
      voter = seller

  case voteResult of
    Right resolvedCid -> do
      resolved <- fromSome <$> queryContractId buyer resolvedCid
      assertMsg "Resolved contribution should carry the proposed data"
        (resolved.contributionData == realData)

      let coefficient p = (fromSome (Map.lookup p resolved.contributorsData)).disputeCoefficient
      -- one winner out of two: the step is 0.5 * 0.5 = 0.25 from the starting 0.5
      assertMsg "Proposer of the winning alternative must be treated as a winner"
        (coefficient buyer == 0.625)
      assertMsg "The party who never held the winning option is a loser"
        (coefficient seller == 0.375)
    Left _ -> fail "Expected auto-resolution once every contributor voted for option 2"

  pure ()

-- Proposing vacates the proposer's previous position. If the dispute then settles on that
-- option nobody stands on it, and every reputation must be left unchanged.
testProposeDisputeDataResolvingOnAVacatedPosition : Script ()
testProposeDisputeDataResolvingOnAVacatedPosition = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-048"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-044"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-049"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-044"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  authorityDisclosure <- fromSome <$> queryDisclosure operator tokenMintAuthorityCid

  let thirdData = sampleContributionData with salePrice = Some 495000.0

  proposeResult <- submit buyer do
    exerciseCmd disputeCid ProposeDisputeData with
      proposer = buyer
      newContributionData = thirdData

  disputeCid2 <- case proposeResult of
    Left cid -> pure cid
    Right _ -> fail "A brand-new alternative cannot resolve the dispute on its own"

  -- settle on index 0, which nobody holds any more: the buyer moved to 2, the seller is at 1
  voteResult1 <- submitWithDisclosures buyer [authorityDisclosure] do
    exerciseCmd disputeCid2 Vote with
      voteForDataIndex = 0
      voter = buyer

  disputeCid3 <- case voteResult1 of
    Left cid -> pure cid
    Right _ -> fail "Expected voting to continue - the seller has not agreed yet"

  voteResult2 <- submitWithDisclosures seller [authorityDisclosure] do
    exerciseCmd disputeCid3 Vote with
      voteForDataIndex = 0
      voter = seller

  case voteResult2 of
    Right resolvedCid -> do
      resolved <- fromSome <$> queryContractId buyer resolvedCid
      assertMsg "Resolved contribution should carry the original data"
        (resolved.contributionData == sampleContributionData)

      let coefficients = map (.disputeCoefficient) (Map.values resolved.contributorsData)
      assertMsg "No contributor may be zeroed out when nobody holds the winning position"
        (all (> 0.0) coefficients)
      assertMsg "Nobody held the winning option, so nobody is penalised relative to anyone else"
        (all (== _internalReputationInitial_) coefficients)
    Left _ -> fail "Expected auto-resolution once every contributor voted for option 0"

  pure ()

testProposeDisputeDataByNonContributorFails : Script ()
testProposeDisputeDataByNonContributorFails = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-044"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-042"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-045"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-042"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  submitMustFail brokerParty do
    exerciseCmd disputeCid ProposeDisputeData with
      proposer = brokerParty
      newContributionData = sampleContributionData with salePrice = Some 600000.0

  pure ()

