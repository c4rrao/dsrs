testOpenDispute : Script ()
testOpenDispute = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-012"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-008"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-013"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-008"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  dispute <- queryContractId buyer disputeCid
  let d = fromSome dispute
  assertMsg "Dispute should have 2 data versions" (length d.allData == 2)
  assertMsg "Dispute should have 2 contributors" (Map.size d.contributorsData == 2)
  assertMsg "Dispute reason should not be empty" (d.reason /= "")

  pure ()

testDisputeAutoResolve : Script ()
testDisputeAutoResolve = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-014"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-009"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-015"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-009"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  -- voters are not stakeholders of the mint authority, so it is disclosed to them
  authorityDisclosure <- fromSome <$> queryDisclosure operator tokenMintAuthorityCid

  voteResult1 <- submitWithDisclosures buyer [authorityDisclosure] do
    exerciseCmd disputeCid Vote with
      voteForDataIndex = 0
      voter = buyer

  case voteResult1 of
    Left newDisputeCid -> do
      voteResult2 <- submitWithDisclosures seller [authorityDisclosure] do
        exerciseCmd newDisputeCid Vote with
          voteForDataIndex = 0  -- Seller changes to match buyer
          voter = seller

      case voteResult2 of
        Right resolvedCid -> do
          resolved <- queryContractId buyer resolvedCid
          let r = fromSome resolved
          assertMsg "Contribution should have correct data" (r.contributionData == sampleContributionData)
          assertMsg "Should have dispute date recorded" (not $ null r.disputeDates)
        Left _ -> fail "Expected auto-resolution but voting continues"

    Right _ -> fail "Expected voting to continue after first vote"

  pure ()

testAddDisputerToDispute : Script ()
testAddDisputerToDispute = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-018"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-011"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-019"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-011"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  updatedDisputeCid <- submit operator do
    exerciseCmd disputeCid AddDisputer with
      newContributorData = makeContributorData brokerParty Broker
      newContributorContributionData = sampleContributionData  -- Broker supports original data

  updatedDispute <- queryContractId buyer updatedDisputeCid
  let ud = fromSome updatedDispute
  assertMsg "Should have 3 contributors" (Map.size ud.contributorsData == 3)
  assertMsg "Broker should be in contributors" (brokerParty `elem` Map.keys ud.contributorsData)

  pure ()

