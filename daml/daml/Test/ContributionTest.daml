  submitMustFail buyer do exerciseCmd contributionCid IsActive

-- Internal reputation is never supplied by the operator, at any of the four choices that seat a
-- party. The fixture passes 1.0, so these tests use a value that is not the initial 0.5.
testDisputeCoefficientIsEarnedNotSupplied : Script ()
testDisputeCoefficientIsEarnedNotSupplied = do
  TestParties{..} <- setupParties

  now <- getTime
  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  let inflated party role = (makeContributorData party role) with disputeCoefficient = 9.0
      coefficientOf party m = (fromSome (Map.lookup party m)).disputeCoefficient

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-COEFF-1"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-COEFF"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = inflated buyer Buyer

  contribution <- queryContractId buyer contributionCid
  assertMsg "AcceptNewContribution seats the contributor at the initial value"
    (coefficientOf buyer (fromSome contribution).contributorsData == _internalReputationInitial_)

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-COEFF-2"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-COEFF"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = inflated seller Seller
      tokenMintAuthorityCid

  dispute <- queryContractId buyer disputeCid
  assertMsg "OpenDispute seats the disputer at the initial value"
    (coefficientOf seller (fromSome dispute).contributorsData == _internalReputationInitial_)

  joinedCid <- submit operator do
    exerciseCmd disputeCid AddDisputer with
      newContributorData = inflated brokerParty Broker
      newContributorContributionData = sampleContributionData

  joined <- queryContractId buyer joinedCid
  assertMsg "AddDisputer seats the joiner at the initial value"
    (coefficientOf brokerParty (fromSome joined).contributorsData == _internalReputationInitial_)

-- Vote copies originalSubmissionDate onto the recreated Contribution, and the auditor's
-- point-in-time replay reads it, so OpenDispute must not restamp it.
testOpenDisputeKeepsTheContributionsOwnDate : Script ()
testOpenDisputeKeepsTheContributionsOwnDate = do
  TestParties{..} <- setupParties

  now <- getTime
  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-DATE-1"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-DATE"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  contribution <- queryContractId buyer contributionCid
  let submittedAt = (fromSome contribution).originalSubmissionDate

  -- the dispute has to happen at a different instant for the assertion to mean anything
  passTime (days 30)
  disputedAt <- getTime
  assertMsg "the test needs time to have moved" (disputedAt /= submittedAt)

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-DATE-2"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-DATE"
      contributionData = differentContributionData
      roleInTransaction = Seller
      requestDate = disputedAt
      createdAt = disputedAt

  disputeCid <- submit operator do
    exerciseCmd requestCid2 OpenDispute with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  dispute <- queryContractId buyer disputeCid
  let d = fromSome dispute
  assertMsg "the dispute carries the contribution's own submission date"
    (d.originalSubmissionDate == submittedAt)
  assertMsg "and not the instant the dispute was opened" (d.createdAt == disputedAt)

testContributionRequestRefusesInvalidData : Script ()
testContributionRequestRefusesInvalidData = do
  TestParties{..} <- setupParties

  now <- getTime

  let request txId cdata = ContributionRequest with
        requestId = "REQ-VALID-" <> txId
        contributor = buyer
        operator
        auditor
        transactionId = TransactionId txId
        contributionData = cdata
        roleInTransaction = Buyer
        requestDate = now
        createdAt = now

  _ <- submit buyer do createCmd (request "TX-VALID-1" sampleContributionData)
  _ <- submit buyer do createCmd (request "TX-VALID-2" sampleContributionData with numberOfRooms = Some 0)

  _ <- submit buyer do
    createCmd (request "TX-VALID-3" sampleContributionData with
      propertyAddress = None, salePrice = None, squareMeters = None, numberOfRooms = None
      yearBuilt = None, energyRating = None, tags = None, propertyType = None)

  submitMustFail buyer do createCmd (request "" sampleContributionData)
  submitMustFail buyer do createCmd (request "TX-BAD-1" sampleContributionData with saleDate = None)
  submitMustFail buyer do createCmd (request "TX-BAD-2" sampleContributionData with salePrice = Some 0.0)
  submitMustFail buyer do createCmd (request "TX-BAD-3" sampleContributionData with salePrice = Some (-1.0))
  submitMustFail buyer do createCmd (request "TX-BAD-4" sampleContributionData with squareMeters = Some 0.0)
  submitMustFail buyer do createCmd (request "TX-BAD-5" sampleContributionData with numberOfRooms = Some (-1))
  submitMustFail buyer do createCmd (request "TX-BAD-6" sampleContributionData with yearBuilt = Some 0)

  submitMustFail buyer do
    createCmd (request "TX-BAD-7" sampleContributionData with saleDate = Some (addDays (toDateUTC now) 1))

  pure ()

