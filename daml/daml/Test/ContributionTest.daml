      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  mergedIsActive <- submit operator do exerciseCmd mergedCid IsActive
  assertMsg "a second party agreeing makes it active" mergedIsActive

