testTrustScoreSingleContributor : Script ()
testTrustScoreSingleContributor = do
  TestParties{..} <- setupParties

  now <- getTime

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-026"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-015"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  contribution <- queryContractId buyer contributionCid
  let c = fromSome contribution
  let ts = c.trustScore

  -- one contributor: redundancy bonus is 1 + 0.1 * log2 1 = 1.0
  assertMsg "Trust score should be positive" (ts.total > 0.0)
  assertMsg "Buyer score should be positive" (ts.buyer.roleScore > 0.0)

  pure ()

