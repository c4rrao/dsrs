module Test.ContributionTest where

import Daml.Script
import DA.Optional (fromSome, isSome)
import qualified DA.Map as Map
import qualified DA.List as List
import DA.Time (days)

import Types
import DA.Date (date, Month(..), addDays, toDateUTC)
import Constants
import Contribution
import Token.Mint (TokenMintAuthority(..))

createTestMintAuthority : Party -> Party -> Script (ContractId TokenMintAuthority)
createTestMintAuthority operator auditor = do
  submit auditor do
    createCmd TokenMintAuthority with
      operator
      auditor

data TestParties = TestParties with
  operator : Party
  auditor : Party
  buyer : Party
  seller : Party
  brokerParty : Party
  notaryParty : Party
  taxParty : Party

setupParties : Script TestParties
setupParties = do
  operator <- allocateParty "Operator"
  auditor <- allocateParty "Auditor"
  buyer <- allocateParty "Buyer"
  seller <- allocateParty "Seller"
  brokerParty <- allocateParty "Broker"
  notaryParty <- allocateParty "Notary"
  taxParty <- allocateParty "TaxAuthority"
  pure TestParties{..}

sampleContributionData : ContributionData
sampleContributionData = ContributionData with
  propertyAddress = Some Address with
    postalCode = Some "12345"
    street = Some "Main Street 1"
    city = Some "Berlin"
    country = Some "Germany"
    additionalInfo = None
  salePrice = Some 500000.0
  saleDate = Some (date 1970 Jan 1)  -- script time starts at the epoch, and a sale cannot postdate its report
  propertyType = Some "Apartment"
  squareMeters = Some 100.0
  numberOfRooms = Some 4
  yearBuilt = Some 2000
  energyRating = Some B
  tags = Some ["renovated", "balcony"]
  additionalInfo = None

differentContributionData : ContributionData
differentContributionData = ContributionData with
  propertyAddress = Some Address with
    postalCode = Some "12345"
    street = Some "Main Street 1"
    city = Some "Berlin"
    country = Some "Germany"
    additionalInfo = None
  salePrice = Some 480000.0  -- different price
  saleDate = Some (date 1970 Jan 1)  -- script time starts at the epoch, and a sale cannot postdate its report
  propertyType = Some "Apartment"
  squareMeters = Some 95.0  -- different square meters
  numberOfRooms = Some 4
  yearBuilt = Some 2000
  energyRating = Some B
  tags = Some ["renovated", "balcony"]
  additionalInfo = None

makeContributorData : Party -> Role -> ContributorData
makeContributorData contributor roleInTransaction = ContributorData with
  contributor
  roleInTransaction
  disputeCoefficient = 1.0
  reputation = 1.0

testAcceptNewContribution : Script ()
testAcceptNewContribution = do
  TestParties{..} <- setupParties

  now <- getTime

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-001"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-001"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  contribution <- queryContractId buyer contributionCid
  let c = fromSome contribution
  assertMsg "Contribution should exist" (c.transactionId == TransactionId "TX-001")
  assertMsg "Trust score should be positive" (c.trustScore.total > 0.0)
  assertMsg "Should have 1 contributor" (Map.size c.contributorsData == 1)

  pure ()

testMergeContribution : Script ()
testMergeContribution = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-002"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-002"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-003"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-002"
      contributionData = sampleContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  mergedCid <- submit operator do
    exerciseCmd requestCid2 MergeContribution with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  merged <- queryContractId buyer mergedCid
  let m = fromSome merged
  assertMsg "Should have 2 contributors" (Map.size m.contributorsData == 2)
  assertMsg "Buyer should be a contributor" (buyer `elem` Map.keys m.contributorsData)
  assertMsg "Seller should be a contributor" (seller `elem` Map.keys m.contributorsData)
  assertMsg "Trust score should increase with more contributors" (m.trustScore.total > 0.0)

  pure ()

testMergeDifferentTransactionFails : Script ()
testMergeDifferentTransactionFails = do
  TestParties{..} <- setupParties

  now <- getTime

  tokenMintAuthorityCid <- createTestMintAuthority operator auditor

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-004"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-003"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  requestCid2 <- submit seller do
    createCmd ContributionRequest with
      requestId = "REQ-005"
      contributor = seller
      operator
      auditor
      transactionId = TransactionId "TX-DIFFERENT"  -- different transaction
      contributionData = sampleContributionData
      roleInTransaction = Seller
      requestDate = now
      createdAt = now

  submitMustFail operator do
    exerciseCmd requestCid2 MergeContribution with
      existingContributionCid = contributionCid
      contributorData = makeContributorData seller Seller
      tokenMintAuthorityCid

  pure ()

