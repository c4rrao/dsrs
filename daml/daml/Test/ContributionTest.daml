testUpdateContributorsData : Script ()
testUpdateContributorsData = do
  TestParties{..} <- setupParties

  now <- getTime

  requestCid <- submit buyer do
    createCmd ContributionRequest with
      requestId = "REQ-031"
      contributor = buyer
      operator
      auditor
      transactionId = TransactionId "TX-019"
      contributionData = sampleContributionData
      roleInTransaction = Buyer
      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  let updatedContributorData = (makeContributorData buyer Buyer) with reputation = 2.0

  updatedCid <- submit operator do
    exerciseCmd contributionCid UpdateContributorsData with
      newContributorsData = [(buyer, updatedContributorData)]

  updated <- queryContractId buyer updatedCid
  let u = fromSome updated
  let buyerData = Map.lookup buyer u.contributorsData
  assertMsg "Buyer data should exist" (buyerData /= None)
  assertMsg "Reputation should be updated" ((fromSome buyerData).reputation == 2.0)

  pure ()

