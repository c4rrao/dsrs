      requestDate = now
      createdAt = now

  contributionCid <- submit operator do
    exerciseCmd requestCid AcceptNewContribution with
      contributorData = makeContributorData buyer Buyer

  aloneIsActive <- submit operator do exerciseCmd contributionCid IsActive
  assertMsg "one contributor is not corroborated" (not aloneIsActive)

