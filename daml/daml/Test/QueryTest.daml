testLockFundsSplitsHolding : Script ()
testLockFundsSplitsHolding = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-SPLIT-001"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal <- queryContractId consumer proposalCid
  let tokenCost = (fromSome proposal).tokenCost

  acceptedProposalCid <- submit escrow do
    exerciseCmd proposalCid AcceptEscrowRole with acceptor = escrow

  let totalTokens = tokenCost * 2
  holdingCid <- createHolding operator auditor consumer totalTokens

  fundedQueryCid <- submit consumer do
    exerciseCmd acceptedProposalCid LockFundsForQuery with
      payedHoldingCid = holdingCid

  consumerHoldings <- query @Holding consumer
  let remainderHoldings = filter (\(_, h) -> h.owner == consumer && h.amount == tokenCost) consumerHoldings
  assertMsg "Consumer should retain remainder tokens" (not $ null remainderHoldings)

  escrowHoldings <- query @Holding escrow
  let lockedPayments = filter (\(_, h) -> h.owner == escrow && h.amount == tokenCost && isSome h.locker) escrowHoldings
  assertMsg "Escrow should have locked payment tokens" (not $ null lockedPayments)

  pure ()

testFailQueryReleasesFunds : Script ()
testFailQueryReleasesFunds = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-013"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal <- queryContractId consumer proposalCid
  let tokenCost = (fromSome proposal).tokenCost

  acceptedProposalCid <- submit escrow do
    exerciseCmd proposalCid AcceptEscrowRole with acceptor = escrow

  holdingCid <- createHolding operator auditor consumer (tokenCost + 1000)

  fundedQueryCid <- submitMulti [consumer] [operator, escrow] do
    exerciseCmd acceptedProposalCid LockFundsForQuery with
      payedHoldingCid = holdingCid

  returnedHoldingCid <- submit operator do
    exerciseCmd fundedQueryCid FailQuery with
      failureReason = "No data available for the query parameters"

  returnedHolding <- queryContractId consumer returnedHoldingCid
  let rh = fromSome returnedHolding
  assertMsg "Funds should return to consumer" (rh.owner == consumer)
  assertMsg "Full amount should be returned" (rh.amount >= tokenCost)

  pure ()

testConsumerReclaimsExpiredFunds : Script ()
testConsumerReclaimsExpiredFunds = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-014"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal <- queryContractId consumer proposalCid
  let tokenCost = (fromSome proposal).tokenCost

  acceptedProposalCid <- submit escrow do
    exerciseCmd proposalCid AcceptEscrowRole with acceptor = escrow

  holdingCid <- createHolding operator auditor consumer (tokenCost + 1000)

  fundedQueryCid <- submitMulti [consumer] [operator, escrow] do
    exerciseCmd acceptedProposalCid LockFundsForQuery with
      payedHoldingCid = holdingCid

  submitMustFail consumer do
    exerciseCmd fundedQueryCid ReclaimExpiredFunds

  passTime (days 1)

  returnedHoldingCid <- submit consumer do
    exerciseCmd fundedQueryCid ReclaimExpiredFunds

  returnedHolding <- queryContractId consumer returnedHoldingCid
  let rh = fromSome returnedHolding
  assertMsg "Funds should return to the consumer" (rh.owner == consumer)
  assertMsg "Full amount should be returned" (rh.amount >= tokenCost)
  assertMsg "Returned holding must not still be locked" (isNone rh.locker)

  pure ()

