-- The privacy floor is enforced on the ledger at two points, pricing and delivery, so an
-- operator that drops its own check still cannot sell an aggregate over too few transactions.

testProposeCostRejectsBelowPrivacyFloor : Script ()
testProposeCostRejectsBelowPrivacyFloor = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-PRIVACY-PRICE"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  -- Zero matters on its own: log2(1 + n) collapses there and the price is clamped up to 1 token.
  submitMustFail operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata with numTransactions = _minTransactionsForPrivacy_ - 1

  submitMustFail operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata with numTransactions = 0

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata with numTransactions = _minTransactionsForPrivacy_

  proposal <- queryContractId consumer proposalCid
  assertMsg "A query exactly at the floor is priced" (isSome proposal)

  pure ()

setupFundedQuery : TestParties -> Text -> Script (ContractId FundedQuery)
setupFundedQuery TestParties{..} requestId = do
  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal <- queryContractId consumer proposalCid
  let tokenCost = (fromSome proposal).tokenCost

  acceptedProposalCid <- submit escrow do
    exerciseCmd proposalCid AcceptEscrowRole with acceptor = escrow

  holdingCid <- createHolding operator auditor consumer (tokenCost + 1000)

  submitMulti [consumer] [operator, escrow] do
    exerciseCmd acceptedProposalCid LockFundsForQuery with
      payedHoldingCid = holdingCid

-- A query priced over enough transactions can lose them to disputes before it is funded. The
-- delivery is refused, and FailQuery must still be reachable to refund the consumer.
testCompleteQueryRejectsBelowPrivacyFloor : Script ()
testCompleteQueryRejectsBelowPrivacyFloor = do
  parties@TestParties{..} <- setupParties
  tokenMintAuthorityCid <- createTestMintAuthority operator auditor
  fundedQueryCid <- setupFundedQuery parties "QR-PRIVACY-DELIVER"

  executionTime <- getTime

  let insightOver n = Level1 with
        base = InsightBase with
          transactionCount = n
          avgSalePrice = Some 500000.0
          avgTrustScore = Some 0.85
          avgYearBuilt = Some 2000.0
          avgSquareMeters = Some 100.0
          avgNumberOfRooms = Some 4.0
          medianEnergyRating = Some B

  submitMustFail operator do
    exerciseCmd fundedQueryCid CompleteQuery with
      queryResults = [insightOver (_minTransactionsForPrivacy_ - 1)]
      executionTimestamp = executionTime
      tokenMintAuthorityCid

  -- every insight must clear the floor, or a targeted one could ride along with a broad one
  submitMustFail operator do
    exerciseCmd fundedQueryCid CompleteQuery with
      queryResults = [insightOver 100, insightOver 1]
      executionTimestamp = executionTime
      tokenMintAuthorityCid

  -- `all` over an empty list is True
  submitMustFail operator do
    exerciseCmd fundedQueryCid CompleteQuery with
      queryResults = []
      executionTimestamp = executionTime
      tokenMintAuthorityCid

  refundedCid <- submit operator do
    exerciseCmd fundedQueryCid FailQuery with
      failureReason = "too few transactions still active to preserve contributor privacy"

  refunded <- queryContractId consumer refundedCid
  assertMsg "Consumer gets the payment back" ((fromSome refunded).owner == consumer)

  pure ()

testCompleteQueryAtPrivacyFloorSucceeds : Script ()
testCompleteQueryAtPrivacyFloorSucceeds = do
  parties@TestParties{..} <- setupParties
  tokenMintAuthorityCid <- createTestMintAuthority operator auditor
  fundedQueryCid <- setupFundedQuery parties "QR-PRIVACY-BOUNDARY"

  executionTime <- getTime

  (resultCid, _rewardCid) <- submit operator do
    exerciseCmd fundedQueryCid CompleteQuery with
      queryResults =
        [ Level1 with
            base = InsightBase with
              transactionCount = _minTransactionsForPrivacy_
              avgSalePrice = Some 500000.0
              avgTrustScore = Some 0.85
              avgYearBuilt = Some 2000.0
              avgSquareMeters = Some 100.0
              avgNumberOfRooms = Some 4.0
              medianEnergyRating = Some B
        ]
      executionTimestamp = executionTime
      tokenMintAuthorityCid

  result <- queryContractId consumer resultCid
  assertMsg "A query exactly at the floor is delivered" (isSome result)

  pure ()

testExpireQueryProposal : Script ()
testExpireQueryProposal = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-EXPIRE-1"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  submit operator do
    exerciseCmd proposalCid ExpireQueryProposal with
      reason = "contribution-set lease ran out before funding"

  proposal <- queryContractId consumer proposalCid
  assertMsg "an expired quote is withdrawn from the ledger" (proposal == None)

testOnlyOperatorCanExpireQueryProposal : Script ()
testOnlyOperatorCanExpireQueryProposal = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-EXPIRE-2"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  submitMustFail consumer do
    exerciseCmd proposalCid ExpireQueryProposal with reason = "expiring it myself"

  submitMustFail operator do
    exerciseCmd proposalCid ExpireQueryProposal with reason = ""

  stillThere <- queryContractId consumer proposalCid
  assertMsg "a refused expiry leaves the quote standing" (stillThere /= None)
