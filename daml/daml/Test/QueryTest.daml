      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]  -- Only escrow, not escrow2
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  submitMustFail escrow2 do
    exerciseCmd proposalCid AcceptEscrowRole with acceptor = escrow2

