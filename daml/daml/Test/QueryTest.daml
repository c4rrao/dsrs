testSetPossibleEscrows : Script ()
testSetPossibleEscrows = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-008"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  updatedCid <- submit operator do
    exerciseCmd proposalCid SetPossibleEscrows with
      newEscrows = [escrow2]

  updatedProposal <- queryContractId consumer updatedCid
  let p = fromSome updatedProposal
  assertMsg "Escrow2 should be possible" (escrow2 `elem` p.possibleEscrows)
  assertMsg "Original escrow should not be possible" (escrow `notElem` p.possibleEscrows)
  assertMsg "Signer should be reset" (p.signerEscrow == None)

  pure ()

