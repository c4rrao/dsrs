module Test.QueryTest where

import Daml.Script
import DA.Optional (fromSome, isSome, isNone)
import DA.Time (days)

import Types
import Constants (_minTransactionsForPrivacy_)
import Query
import Pricing
import Token.Holding
import Token.Mint (TokenMintAuthority(..))

createTestMintAuthority : Party -> Party -> Script (ContractId TokenMintAuthority)
createTestMintAuthority operator auditor = do
  submit auditor do
    createCmd TokenMintAuthority with
      operator
      auditor

data TestParties = TestParties with
  operator : Party
  auditor : Party
  consumer : Party
  escrow : Party
  escrow2 : Party
  public : Party

setupParties : Script TestParties
setupParties = do
  operator <- allocateParty "Operator"
  auditor <- allocateParty "Auditor"
  consumer <- allocateParty "Consumer"
  escrow <- allocateParty "Escrow"
  escrow2 <- allocateParty "Escrow2"
  public <- allocateParty "Public"
  pure TestParties{..}

sampleQueryParams : QueryParams
sampleQueryParams = QueryParams with
  level = 1
  trustScore = None
  propertyAddress = None
  salePrice = None
  saleDate = None
  propertyTypes = None
  squareMeters = None
  numberOfRooms = None
  yearBuilt = None
  energyRating = None
  tags = None

samplePricingMetadata : PricingMetadata
samplePricingMetadata = PricingMetadata with
  numTransactions = 100
  corpusTransactions = 1000
  addressSelectivity = 0.0
  salePriceSelectivity = 0.0
  saleDateSelectivity = 0.0
  squareMetersSelectivity = 0.0
  yearBuiltSelectivity = 0.0
  roomsSelectivity = 0.0
  propertyTypeSelectivity = 0.0
  energyRatingSelectivity = 0.0
  tagsSelectivity = 0.0
  trustQuality = 0.0

setupPricingConfig : Party -> Party -> Party -> Script (ContractId PricingConfig)
setupPricingConfig operator auditor public = do
  now <- getTime
  submit operator do
    createCmd (defaultPricingConfig operator auditor public now)

createHolding : Party -> Party -> Party -> Int -> Script (ContractId Holding)
createHolding operator auditor owner amount = do
  now <- getTime
  submitMulti [operator, auditor, owner] [] do
    createCmd Holding with
      owner
      issuer = operator
      witness = auditor
      tokenType = RewardToken
      amount
      locker = None
      lockReleaseTime = None
      createdAt = now

testQueryRequestToProposal : Script ()
testQueryRequestToProposal = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-001"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposalCid <- submit operator do
    exerciseCmd requestCid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal <- queryContractId consumer proposalCid
  let p = fromSome proposal
  assertMsg "Proposal should have correct consumer" (p.consumer == consumer)
  assertMsg "Token cost should be positive" (p.tokenCost > 0)
  assertMsg "Escrow should be in possibleEscrows" (escrow `elem` p.possibleEscrows)
  assertMsg "No signer escrow yet" (p.signerEscrow == None)

  pure ()

testQueryRequestRequiresEscrow : Script ()
testQueryRequestRequiresEscrow = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-002"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  submitMustFail operator do
    exerciseCmd requestCid ProposeCost with
      escrows = []
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  pure ()

testRejectQueryRequest : Script ()
testRejectQueryRequest = do
  TestParties{..} <- setupParties

  now <- getTime

  requestCid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-003"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  submit operator do
    exerciseCmd requestCid RejectQueryRequest with
      reason = "Insufficient transaction data available"

  request <- queryContractId consumer requestCid
  assertMsg "Request should be archived" (request == None)

  pure ()

