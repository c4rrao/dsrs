testLevel2HigherCostThanLevel1 : Script ()
testLevel2HigherCostThanLevel1 = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  request1Cid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-014"
      consumer
      operator
      auditor
      params = sampleQueryParams with level = 1
      requestDate = now
      createdAt = now

  proposal1Cid <- submit operator do
    exerciseCmd request1Cid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal1 <- queryContractId consumer proposal1Cid
  let level1Cost = (fromSome proposal1).tokenCost

  request2Cid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-015"
      consumer
      operator
      auditor
      params = sampleQueryParams with level = 2
      requestDate = now
      createdAt = now

  proposal2Cid <- submit operator do
    exerciseCmd request2Cid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata

  proposal2 <- queryContractId consumer proposal2Cid
  let level2Cost = (fromSome proposal2).tokenCost

  assertMsg "Level 2 should cost more than Level 1" (level2Cost > level1Cost)

  pure ()

testMoreTransactionsCostsMore : Script ()
testMoreTransactionsCostsMore = do
  TestParties{..} <- setupParties

  now <- getTime
  pricingCid <- setupPricingConfig operator auditor public

  request1Cid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-016"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposal1Cid <- submit operator do
    exerciseCmd request1Cid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata with numTransactions = 10

  proposal1 <- queryContractId consumer proposal1Cid
  let fewTxCost = (fromSome proposal1).tokenCost

  request2Cid <- submit consumer do
    createCmd QueryRequest with
      requestId = "QR-017"
      consumer
      operator
      auditor
      params = sampleQueryParams
      requestDate = now
      createdAt = now

  proposal2Cid <- submit operator do
    exerciseCmd request2Cid ProposeCost with
      escrows = [escrow]
      pricingConfigCid = pricingCid
      metadata = samplePricingMetadata with numTransactions = 1000

  proposal2 <- queryContractId consumer proposal2Cid
  let manyTxCost = (fromSome proposal2).tokenCost

  assertMsg "More transactions should cost more" (manyTxCost > fewTxCost)

  pure ()

