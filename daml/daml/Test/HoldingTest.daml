testRejectHoldingOffer : Script ()
testRejectHoldingOffer = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  offerCid <- submit alice do
    exerciseCmd holdingCid TransferAll with recipient = bob; reference = None

  returnedCid <- submit bob do
    exerciseCmd offerCid RejectHoldingOffer

  returned <- queryContractId alice returnedCid
  assertMsg "Tokens should return to Alice" ((fromSome returned).owner == alice)
  assertMsg "Amount should be preserved" ((fromSome returned).amount == 1000)

  pure ()

testCancelHoldingOffer : Script ()
testCancelHoldingOffer = do
  TestParties{..} <- setupParties
  now <- getTime

  offerCid <- submitMulti [alice, operator, auditor] [] do
    createCmd HoldingOffer with
      from = alice
      to = bob
      issuer = operator
      witness = auditor
      tokenType = RewardToken
      amount = 500
      cancellable = True
      reference = None
      createdAt = now

  returnedCid <- submit alice do
    exerciseCmd offerCid CancelHoldingOffer

  returned <- queryContractId alice returnedCid
  assertMsg "Tokens should return to Alice" ((fromSome returned).owner == alice)

  pure ()

testCancelNonCancellableOffer : Script ()
testCancelNonCancellableOffer = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  (offerCid, _) <- submit alice do
    exerciseCmd holdingCid Transfer with
      recipient = bob
      transferAmount = 500
      reference = None

  submitMustFail alice do
    exerciseCmd offerCid CancelHoldingOffer

  pure ()

testEurToToken : Script ()
testEurToToken = do
  let tokens = eurToToken 1.0
  assertMsg "1 EUR should be 1,000,000 tokens" (tokens == 1_000_000)

  let tokens2 = eurToToken 10.5
  assertMsg "10.5 EUR should be 10,500,000 tokens" (tokens2 == 10_500_000)

  pure ()

testTokenToEur : Script ()
testTokenToEur = do
  let eur = tokenToEur 1_000_000
  assertMsg "1,000,000 tokens should be 1 EUR" (eur == 1.0)

  let eur2 = tokenToEur 500_000
  assertMsg "500,000 tokens should be 0.5 EUR" (eur2 == 0.5)

  pure ()
