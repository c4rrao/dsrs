  aliceHolding <- createHolding operator auditor alice 100
  bobHolding <- createHolding operator auditor bob 200

  submitMustFail alice do
    exerciseCmd aliceHolding Merge with otherCids = [bobHolding]

  pure ()

testMergeLockedHolding : Script ()
testMergeLockedHolding = do
