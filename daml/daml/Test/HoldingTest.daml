testSplitHolding : Script ()
testSplitHolding = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  (h1, h2) <- submit alice do
    exerciseCmd holdingCid Split with splitAmount = 400

  holding1 <- queryContractId alice h1
  holding2 <- queryContractId alice h2

  assertMsg "First holding should have 400 tokens" ((fromSome holding1).amount == 400)
  assertMsg "Second holding should have 600 tokens" ((fromSome holding2).amount == 600)

  pure ()

