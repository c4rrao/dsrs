testDeleteZeroHolding : Script ()
testDeleteZeroHolding = do
  TestParties{..} <- setupParties
  now <- getTime

  holdingCid <- submitMulti [operator, auditor, alice] [] do
    createCmd Holding with
      owner = alice
      issuer = operator
      witness = auditor
      tokenType = RewardToken
      amount = 0
      locker = None
      lockReleaseTime = None
      createdAt = now

  submit alice do
    exerciseCmd holdingCid Delete with actor = alice

  holding <- queryContractId alice holdingCid
  assertMsg "Holding should be deleted" (holding == None)

  pure ()

