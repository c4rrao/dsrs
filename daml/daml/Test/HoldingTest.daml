testLockUnlock : Script ()
testLockUnlock = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  lockedCid <- submit alice do
    exerciseCmd holdingCid Lock with
      locker = operator
      releaseTime = None

  locked <- queryContractId alice lockedCid
  assertMsg "Holding should be locked for operator" ((fromSome locked).locker == Some operator)

  unlockedCid <- submit operator do
    exerciseCmd lockedCid Unlock

  unlocked <- queryContractId alice unlockedCid
  assertMsg "Holding should be unlocked" ((fromSome unlocked).locker == None)

  pure ()

testOwnerCannotLockToSelf : Script ()
testOwnerCannotLockToSelf = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  submitMustFail alice do
    exerciseCmd holdingCid Lock with
      locker = alice
      releaseTime = None

  pure ()

