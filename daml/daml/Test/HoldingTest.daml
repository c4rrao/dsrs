  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 100

  submitMustFail alice do
    exerciseCmd holdingCid Burn with burnAmount = Some 150

  pure ()

testBurnLockedHolding : Script ()
testBurnLockedHolding = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 100

  lockedCid <- submit alice do
    exerciseCmd holdingCid Lock with locker = operator; releaseTime = None

  submitMustFail alice do
