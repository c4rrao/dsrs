testLockedTransferToLocker : Script ()
testLockedTransferToLocker = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  lockedCid <- submit alice do
    exerciseCmd holdingCid Lock with
      locker = bob
      releaseTime = None

  offerCid <- submit alice do
    exerciseCmd lockedCid TransferAll with recipient = bob; reference = None

  bobHoldingCid <- submit bob do
    exerciseCmd offerCid AcceptHoldingOffer

  bobHolding <- queryContractId bob bobHoldingCid
  assertMsg "Bob should have the tokens" ((fromSome bobHolding).amount == 1000)

  pure ()

testRemoveLockAfterReleaseTime : Script ()
testRemoveLockAfterReleaseTime = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  now <- getTime
  let releaseTime = addRelTime now (days 1)

  lockedCid <- submit alice do
    exerciseCmd holdingCid Lock with
      locker = operator
      releaseTime = Some releaseTime

  submitMustFail alice do
    exerciseCmd lockedCid RemoveLock

  setTime (addRelTime releaseTime (days 1))

  unlockedCid <- submit alice do
    exerciseCmd lockedCid RemoveLock

  unlocked <- queryContractId alice unlockedCid
  assertMsg "Holding should be unlocked" ((fromSome unlocked).locker == None)

  pure ()

testMergeHoldings : Script ()
testMergeHoldings = do
  TestParties{..} <- setupParties

  h1 <- createHolding operator auditor alice 100
  h2 <- createHolding operator auditor alice 200
  h3 <- createHolding operator auditor alice 300

  mergedCid <- submit alice do
    exerciseCmd h1 Merge with otherCids = [h2, h3]

  merged <- queryContractId alice mergedCid
  assertMsg "Merged holding should have 600 tokens" ((fromSome merged).amount == 600)

  h2' <- queryContractId alice h2
  h3' <- queryContractId alice h3
  assertMsg "h2 should be archived" (h2' == None)
  assertMsg "h3 should be archived" (h3' == None)

  pure ()

testMergeEmptyList : Script ()
testMergeEmptyList = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 100

  submitMustFail alice do
    exerciseCmd holdingCid Merge with otherCids = []

  pure ()

testMergeSameTokenTypes : Script ()
testMergeSameTokenTypes = do
  TestParties{..} <- setupParties

  -- RewardToken is the only type a test holding is created with
  h1 <- createHolding operator auditor alice 100
  h2 <- createHolding operator auditor alice 200

  mergedCid <- submit alice do
    exerciseCmd h1 Merge with otherCids = [h2]

  merged <- queryContractId alice mergedCid
  assertMsg "Merged holding should have 300 tokens" ((fromSome merged).amount == 300)

  pure ()

