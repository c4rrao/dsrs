module Test.HoldingTest where

import Daml.Script
import DA.Time (days, addRelTime)
import DA.Optional (fromSome)

import Types
import Token.Holding

data TestParties = TestParties with
  operator : Party   -- Acts as issuer for RewardToken
  auditor : Party    -- Acts as witness for RewardToken
  alice : Party
  bob : Party
  charlie : Party

setupParties : Script TestParties
setupParties = do
  operator <- allocateParty "Operator"
  auditor <- allocateParty "Auditor"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  charlie <- allocateParty "Charlie"
  pure TestParties{..}

createHolding : Party -> Party -> Party -> Int -> Script (ContractId Holding)
createHolding issuer witness owner amount = do
  now <- getTime
  submitMulti [issuer, witness, owner] [] do
    createCmd Holding with
      owner
      issuer
      witness
      tokenType = RewardToken
      amount
      locker = None
      lockReleaseTime = None
      createdAt = now

testCreateHolding : Script ()
testCreateHolding = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  holding <- queryContractId alice holdingCid
  assertMsg "Holding should exist" ((fromSome holding).amount == 1000)
  pure ()

testHoldingEnsureNonNegativeAmount : Script ()
testHoldingEnsureNonNegativeAmount = do
  TestParties{..} <- setupParties
  now <- getTime

  submitMultiMustFail [operator, auditor, alice] [] do
    createCmd Holding with
      owner = alice
      issuer = operator
      witness = auditor
      tokenType = RewardToken
      amount = -100
      locker = None
      lockReleaseTime = None
      createdAt = now

  pure ()

testHoldingZeroAmount : Script ()
testHoldingZeroAmount = do
  TestParties{..} <- setupParties
  now <- getTime

  holdingCid <- submitMulti [operator, auditor, alice] [] do
    createCmd Holding with
      owner = alice
      issuer = operator
      witness = auditor
      tokenType = RewardToken
      amount = 0
      locker = None
      lockReleaseTime = None
      createdAt = now

  holding <- queryContractId alice holdingCid
  assertMsg "Zero amount holding should exist" ((fromSome holding).amount == 0)
  pure ()

testPartialTransfer : Script ()
testPartialTransfer = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  (offerCid, remainingCid) <- submit alice do
    exerciseCmd holdingCid Transfer with
      recipient = bob
      transferAmount = 300
      reference = None

  bobHoldingCid <- submit bob do
    exerciseCmd offerCid AcceptHoldingOffer

  aliceHolding <- queryContractId alice remainingCid
  bobHolding <- queryContractId bob bobHoldingCid

  assertMsg "Alice should have 700 tokens" ((fromSome aliceHolding).amount == 700)
  assertMsg "Bob should have 300 tokens" ((fromSome bobHolding).amount == 300)

  pure ()

testTransferAll : Script ()
testTransferAll = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 1000

  offerCid <- submit alice do
    exerciseCmd holdingCid TransferAll with recipient = bob; reference = None

  bobHoldingCid <- submit bob do
    exerciseCmd offerCid AcceptHoldingOffer

  bobHolding <- queryContractId bob bobHoldingCid
  assertMsg "Bob should have 1000 tokens" ((fromSome bobHolding).amount == 1000)

  aliceHolding <- queryContractId alice holdingCid
  assertMsg "Alice's original holding should be archived" (aliceHolding == None)

  pure ()

