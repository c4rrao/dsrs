testBurnComplete : Script ()
testBurnComplete = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 100

  result <- submit alice do
    exerciseCmd holdingCid Burn with burnAmount = Some 100

  assertMsg "Complete burn should return None" (result == None)

  pure ()

testBurnPartial : Script ()
testBurnPartial = do
  TestParties{..} <- setupParties

  holdingCid <- createHolding operator auditor alice 100

  result <- submit alice do
    exerciseCmd holdingCid Burn with burnAmount = Some 40

  case result of
    None -> assertMsg "Partial burn should return remaining holding" False
    Some remainingCid -> do
      remaining <- queryContractId alice remainingCid
      assertMsg "Remaining should have 60 tokens" ((fromSome remaining).amount == 60)

  pure ()

testBurnEntireWithNone : Script ()
testBurnEntireWithNone = do
